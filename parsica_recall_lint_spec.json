{
  "spec_name": "Parsica Recall Question Lint Spec",
  "spec_version": "v10-lint-spec-3",
  "recall_spec": "recall/1.0",
  "purpose": [
    "Reject low-specificity questions and answer keys before a set is used.",
    "See the pool, not just the item: a key is judged against every record a retriever can return.",
    "Every release gate is code with a pass or fail result."
  ],
  "required_fields": [
    "id",
    "question",
    "category",
    "difficulty",
    "answer_type",
    "answer",
    "acceptable_answers",
    "gold_ids",
    "must_rank_first",
    "gold_hashes",
    "review_status",
    "review_notes"
  ],
  "enums": {
    "category": [
      "direct_recall_user",
      "direct_recall_agent",
      "entity_attribution",
      "temporal_awareness",
      "paraphrase_recall",
      "cross_session",
      "long_horizon",
      "vocabulary_gap",
      "knowledge_update",
      "correction_handling",
      "implicit_preference",
      "abstention",
      "recency_preference"
    ],
    "difficulty": ["easy", "medium", "hard"],
    "answer_type": [
      "entity",
      "role",
      "date",
      "duration",
      "number",
      "quantity_with_unit",
      "phrase",
      "boolean",
      "formula",
      "code_symbol",
      "id",
      "version",
      "abstention"
    ],
    "review_status": ["publish", "rewrite", "reclassify", "drop", "hold_experimental"],
    "severity": ["error", "warn", "info"]
  },
  "constants": {
    "min_answer_chars": 4,
    "short_answer_type_whitelist": ["date", "number", "formula", "code_symbol", "id", "version"],
    "short_answer_numeric_regex": "^[0-9]+$",
    "short_answer_time_regex": "^[0-9]{1,4} ?[ap]m$",
    "min_gold_tokens": 6,
    "max_alternate_pool_share": 0.01,
    "min_category_items": 25,
    "prohibited_exact_answers": [
      "i", "me", "my", "we", "they", "he", "she", "it", "a", "an", "the",
      "the post", "the author", "the poster", "the one", "post", "author", "poster",
      "place", "services", "distance", "race", "subreddit", "moment", "query",
      "calories", "points", "year", "date"
    ],
    "prohibited_acceptable_fragments": [
      "the", "a", "an", "i", "the post", "the author", "the poster", "post", "author", "poster"
    ],
    "pronoun_answers": [
      "i", "he", "she", "they", "we", "it", "the post", "the author", "the poster", "post", "author", "poster"
    ],
    "unit_terms": [
      "calories", "lbs", "pounds", "kg", "months", "days", "years", "minutes", "hours",
      "%", "percent", "weeks", "miles", "km", "dollars", "$", "£", "€"
    ],
    "role_answer_whitelist": ["post author", "original poster"],
    "stated_preference_terms": [
      "prefer", "prefers", "preferred", "preference", "favorite", "favourite", "favorites", "favourites",
      "rather", "always", "never", "usually", "love", "loves", "hate", "hates", "like best", "cant stand",
      "go-to", "swear by", "stick with", "from now on", "only buy", "only use", "my pick", "big fan"
    ],
    "temporal_terms": [
      "date", "time", "year", "month", "day", "before", "after", "latest", "earlier", "later",
      "duration", "when", "first", "last", "recent", "previous", "next", "sequence", "order",
      "timeline", "since", "until", "ago", "week", "hour", "minute"
    ],
    "question_words": [
      "what", "which", "how", "who", "when", "where", "why", "the", "according", "in", "on",
      "a", "an", "is", "are", "was", "were", "do", "does", "did", "after", "before", "one",
      "someone", "users", "user", "thinking", "if", "for", "from", "as"
    ],
    "distractor_ks_tolerance": 0.1
  },
  "rules": [
    {"id": "SCHEMA_REQUIRED_FIELDS", "severity": "error", "match": {"type": "required_fields"},
     "action": {"set_review_status": "drop"}},
    {"id": "SCHEMA_ENUM_VALIDITY", "severity": "error",
     "match": {"type": "enum_membership", "fields": ["category", "difficulty", "answer_type", "review_status"]},
     "action": {"set_review_status": "drop"}},
    {"id": "SCHEMA_GOLD_SHAPE", "severity": "error", "match": {"type": "gold_shape"},
     "action": {"set_review_status": "drop"}},
    {"id": "GOLD_PRESENT", "severity": "error", "match": {"type": "gold_present"},
     "action": {"set_review_status": "drop"}},
    {"id": "ABSTENTION_SHAPE", "severity": "error", "match": {"type": "abstention_shape"},
     "action": {"set_review_status": "reclassify"}},
    {"id": "MULTI_RECORD_SHAPE", "severity": "error", "match": {"type": "multi_record_shape"},
     "action": {"set_review_status": "reclassify"}},
    {"id": "SOURCE_LENGTH", "severity": "error", "match": {"type": "source_length"},
     "action": {"set_review_status": "drop"}},
    {"id": "PRIMARY_ANSWER_TOO_SHORT", "severity": "error",
     "match": {"type": "min_length", "field": "answer"},
     "action": {"set_review_status": "rewrite"}},
    {"id": "ACCEPTABLE_ANSWER_TOO_SHORT", "severity": "error",
     "match": {"type": "min_length", "field": "acceptable_answers"},
     "action": {"set_review_status": "rewrite"}},
    {"id": "PRIMARY_PROHIBITED_TOKEN", "severity": "error",
     "match": {"type": "prohibited_values", "field": "answer", "values": "prohibited_exact_answers"},
     "action": {"set_review_status": "rewrite"}},
    {"id": "ACCEPTABLE_PROHIBITED_FRAGMENT", "severity": "error",
     "match": {"type": "prohibited_values", "field": "acceptable_answers", "values": "prohibited_acceptable_fragments"},
     "action": {"set_review_status": "rewrite"}},
    {"id": "ROLE_ANSWER_MUST_BE_STABLE_LABEL", "severity": "error", "match": {"type": "role_label"},
     "action": {"set_review_status": "rewrite"}},
    {"id": "ENTITY_ANSWER_MUST_NOT_BE_PRONOUN", "severity": "error", "match": {"type": "entity_not_pronoun"},
     "action": {"set_review_status": "rewrite"}},
    {"id": "QUANTITY_REQUIRES_UNIT", "severity": "error",
     "match": {"type": "quantity_unit", "field": "answer"},
     "action": {"set_review_status": "rewrite"}},
    {"id": "ACCEPTABLE_QUANTITY_REQUIRES_UNIT", "severity": "error",
     "match": {"type": "quantity_unit", "field": "acceptable_answers"},
     "action": {"set_review_status": "rewrite"}},
    {"id": "KEY_EDGES", "severity": "error", "match": {"type": "key_edges"},
     "action": {"set_review_status": "rewrite"}},
    {"id": "ANSWER_NOT_IN_QUESTION", "severity": "error", "match": {"type": "answer_not_in_question"},
     "action": {"set_review_status": "rewrite"}},
    {"id": "GOLD_MULTIPLICITY", "severity": "error", "match": {"type": "gold_multiplicity"},
     "action": {"set_review_status": "rewrite"}},
    {"id": "ALTERNATE_SPECIFICITY", "severity": "error", "match": {"type": "alternate_specificity"},
     "action": {"set_review_status": "rewrite"}},
    {"id": "VOCAB_GAP_ANSWER_VERBATIM_IN_GOLD", "severity": "error", "match": {"type": "vocab_gap_verbatim"},
     "action": {"set_review_status": "reclassify"}},
    {"id": "VOCAB_GAP_QUESTION_OVERLAP_TOO_HIGH", "severity": "warn",
     "match": {"type": "vocab_gap_overlap", "max_overlap": 0.55},
     "action": {"set_review_status": "reclassify"}},
    {"id": "TEMPORAL_AWARENESS_REQUIRES_TEMPORAL_SIGNAL", "severity": "warn", "match": {"type": "temporal_signal"},
     "action": {"set_review_status": "reclassify"}},
    {"id": "IMPLICIT_PREFERENCE_MUST_NOT_BE_EXPLICIT", "severity": "warn",
     "match": {"type": "implicit_explicitness", "max_ratio": 0.85},
     "action": {"set_review_status": "reclassify"}},
    {"id": "ENTITY_COHERENCE", "severity": "warn", "match": {"type": "entity_coherence"},
     "action": {"set_review_status": null}},
    {"id": "NO_SECRETS_OR_PII", "severity": "error", "match": {"type": "secrets_pii_item"},
     "action": {"set_review_status": "drop"}},
    {"id": "GOLD_NEAR_COPY", "severity": "warn", "match": {"type": "gold_near_copy", "min_overlap": 0.9},
     "action": {"set_review_status": null}}
  ],
  "set_rules": [
    {"id": "UNIQUE_QUESTION_ID", "severity": "error", "type": "unique_field", "field": "id"},
    {"id": "UNIQUE_QUESTION_TEXT", "severity": "error", "type": "unique_question_text"},
    {"id": "DUPLICATE_FACT", "severity": "warn", "type": "duplicate_fact",
     "action": {"set_review_status": "reclassify"}}
  ],
  "pool_rules": [
    {"id": "NO_SECRETS_OR_PII_POOL", "severity": "error", "type": "secrets_pii_pool"}
  ],
  "gates": [
    {"id": "GATE_PRIMARY_MIN_LENGTH", "type": "no_findings", "rules": ["PRIMARY_ANSWER_TOO_SHORT"],
     "prose": "No primary answer of 3 characters or fewer unless whitelisted by answer_type, all digits, or a time of day such as 9pm."},
    {"id": "GATE_ACCEPTABLE_MIN_LENGTH", "type": "no_findings", "rules": ["ACCEPTABLE_ANSWER_TOO_SHORT"],
     "prose": "No acceptable answer of 3 characters or fewer unless whitelisted by answer_type, all digits, or a time of day such as 9pm."},
    {"id": "GATE_NO_PRONOUN_ENTITY_ANSWERS", "type": "no_findings", "rules": ["ENTITY_ANSWER_MUST_NOT_BE_PRONOUN"],
     "prose": "No pronoun-only entity answers."},
    {"id": "GATE_NO_FRAGMENT_ANSWERS", "type": "no_findings",
     "rules": ["ACCEPTABLE_PROHIBITED_FRAGMENT", "PRIMARY_PROHIBITED_TOKEN", "KEY_EDGES"],
     "prose": "No article-only or discourse-fragment answers, and no key cut on a function word."},
    {"id": "GATE_VOCAB_GAP_ITEMS_CLEAN", "type": "category_clean", "category": "vocabulary_gap",
     "allowed_statuses": ["publish", "hold_experimental"],
     "prose": "All vocabulary_gap items pass lint and are not marked miscategorized or unreasonable."},
    {"id": "GATE_ENTITY_ATTRIBUTION_RESOLVES", "type": "entity_attribution_resolves",
     "rules": ["ROLE_ANSWER_MUST_BE_STABLE_LABEL", "ENTITY_ANSWER_MUST_NOT_BE_PRONOUN"],
     "answer_types": ["entity", "role"],
     "prose": "All entity_attribution answers resolve to a real entity or a stable role label."},
    {"id": "GATE_VERSIONS_MATCH", "type": "versions_match",
     "prose": "README, harness, category count and question-file version match the released suite."},
    {"id": "GATE_PUBLISH_ONLY", "type": "publish_only",
     "prose": "The released suite contains only review_status=publish items."},
    {"id": "GATE_ZERO_ITEM_ERRORS", "type": "no_severity", "severity": "error",
     "prose": "No item carries an error finding."},
    {"id": "GATE_UNIQUE_QUESTIONS", "type": "no_findings", "rules": ["UNIQUE_QUESTION_ID", "UNIQUE_QUESTION_TEXT"],
     "prose": "Question ids and question texts are unique (the oracle looks questions up by text)."},
    {"id": "GATE_CATEGORY_MINIMUMS", "type": "category_minimums",
     "prose": "Each category has at least 25 publishable items in the standard set."},
    {"id": "GATE_NO_SECRETS_OR_PII", "type": "no_findings", "rules": ["NO_SECRETS_OR_PII", "NO_SECRETS_OR_PII_POOL"],
     "prose": "No record, question, answer or distractor matches a credential or personal-data shape."},
    {"id": "GATE_DISTRACTOR_MATCH", "type": "distractor_match",
     "prose": "The distractor file's token-length and timestamp distributions sit within tolerance of the corpus's."}
  ],
  "notes": {
    "normalization": "Every text rule uses recall_common.normalize, the same function the runner scores with. Phrase containment is whole-token.",
    "gold_multiplicity": "Read as the spec's parenthetical: no record outside the gold set contains the answer or an alternate. Outside vocabulary_gap and implicit_preference (whose answers are by design not verbatim), the answer or an alternate must also appear in a gold record, and for version questions in the must_rank_first record (in every one, when must_rank_first is a list of records that each carry the current version word for word), so the exact diagnostic can reach it. Role labels are excepted: an item whose answer_type is role gets neither finding, because a role label says who acted and is not a span of the record; ROLE_ANSWER_MUST_BE_STABLE_LABEL checks its answer and every alternate against role_answer_whitelist instead.",
    "key_edges": "Function words are the closed classes in recall_common.FUNCTION_WORDS. Personal pronouns, negation, phrasal-verb particles, 'may' and 'am' are left out because keys naturally start or end on them.",
    "quantity_unit": "Unit detection reads the raw lowercased answer, since normalization strips symbols such as $ and %.",
    "min_length": "A key under min_answer_chars after normalization passes when its answer_type is whitelisted, when it is all digits (short_answer_numeric_regex), or when it is a time of day such as 9pm (short_answer_time_regex; spec 3, October 21, 2026).",
    "implicit_explicitness": "Fires when most of the answer's words are in the gold record and the gold record states a preference outright (one of stated_preference_terms). The preferred thing's own name, in a record that shows the preference without stating it, is a fine answer (spec 3, October 21, 2026).",
    "abstention": "Abstention items carry no gold ids and are exempt from the answer-key rules; retrieval mode scores them only from adapter scores.",
    "secrets_pii": "Shapes written fresh for Recall: provider key prefixes, private-key blocks, JWTs, credentials in connection strings, long high-entropy tokens; emails, phone numbers, street addresses, US SSNs, UK NI numbers and Luhn-valid card numbers."
  }
}
